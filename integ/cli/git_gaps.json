{
  "cases": [
    {
      "id": "git_show_blob_parent",
      "seq": 567900,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git -C /repo show HEAD~1:numbers.txt",
      "expect": {
        "exit": 0,
        "stdout": "one\n",
        "stderr": ""
      }
    },
    {
      "id": "git_show_blob_caret",
      "seq": 567901,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git -C /repo show HEAD^:docs/readme.md",
      "expect": {
        "exit": 0,
        "stdout": "notes\n",
        "stderr": ""
      }
    },
    {
      "id": "git_ls_files",
