      "id": "git_log_perl_regexp_property",
      "seq": 567912,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git -C /repo log -P --grep='^add \\p{Ll}{4}$' --format=%s",
      "expect": {
        "exit": 0,
        "stdout": "add docs\n",
        "stderr": ""
      }
    },
    {
      "id": "git_log_grep_refusal_names_pattern",
      "seq": 567913,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git -C /repo log --grep='\\(' --format=%s",
      "expect": {
        "exit": 128,
        "stdout": "",
        "stderr": "fatal: command line, '\\(': Unmatched ( or \\(\n"
      }
    },
    {
      "id": "git_log_mailmap_placeholder",
      "seq": 568900,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "printf 'Canonical Author <integ@example.com>\\n' > /repo/.mailmap && git -C /repo log -1 --format='%an|%aN' 98b4ffe",
      "expect": {
        "exit": 0,
        "stdout": "Integ Author|Canonical Author\n",
        "stderr": ""
      }
    },
    {
      "id": "git_config_global_override",
      "seq": 568901,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "printf '[user]\\n\\tname = Global Author\\n' > /repo/global-config && GIT_CONFIG_GLOBAL=/repo/global-config git config --global --get user.name",
      "expect": {
        "exit": 0,
        "stdout": "Global Author\n",
        "stderr": ""
      }
    },
    {
      "id": "git_config_global_missing",
      "seq": 568902,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "HOME=/repo/no-home git config --global --list",
      "expect": {
        "exit": 128,
        "stdout": "",
        "stderr": "fatal: unable to read config file '/repo/no-home/.gitconfig': No such file or directory\n"
      }
    },
    {
      "id": "git_status_short_ignored",
      "seq": 568903,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "printf '*.log\\n' > /repo/.gitignore && echo ignored > /repo/debug.log && git -C /repo status --short --ignored | grep '^!! debug.log'",
      "expect": {
        "exit": 0,
        "stdout": "!! debug.log\n",
        "stderr": ""
      }
    },
    {
      "id": "git_mailmap_name_and_email_entry_wins",
      "seq": 568904,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "printf 'Simple <integ@example.com>\\n<canonical@example.com> Integ Author <integ@example.com>\\n' > /repo/.mailmap && git -C /repo log -1 --format='%aN <%aE>' 98b4ffe",
      "expect": {
        "exit": 0,
        "stdout": "Integ Author <canonical@example.com>\n",
        "stderr": ""
      }
    },
    {
      "id": "git_log_extended_regexp_glibc_escape",
      "seq": 13470101,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git -C /repo log -E --grep='del\\ta' --format=%s",
      "expect": {
        "exit": 0,
        "stdout": "add delta\n",
        "stderr": ""
      }
    },
    {
      "id": "git_log_extended_regexp_refuses_a_bare_question",
      "seq": 13470102,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git -C /repo log -E --grep='(?:id)' --format=%s",
      "expect": {
        "exit": 128,
        "stdout": "",
        "stderr": "fatal: command line, '(?:id)': Invalid preceding regular expression\n"
      }
    },
    {
      "id": "git_log_extended_regexp_refuses_a_bad_interval",
      "seq": 13470103,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git -C /repo log -E --grep='a{x}' --format=%s",
      "expect": {
        "exit": 128,
        "stdout": "",
        "stderr": "fatal: command line, 'a{x}': Invalid content of \\{\\}\n"
      }
    },
    {
      "id": "git_config_get_regexp_reads_glibc_ere",
      "seq": 13470104,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git -C /repo config --get-regexp 'user.(?:name)'; echo rc=$?",
      "expect": {
        "exit": 0,
        "stdout": "rc=6\n",
        "stderr": "error: invalid key pattern: user.(?:name)\n"
      }
    }
