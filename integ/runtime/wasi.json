    {
      "id": "reads_and_writes_reach_the_mount",
      "hosts": [
        "python"
      ],
      "backends": [
        "ram",
        "s3",
        "redis"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "lines.txt": "one\ntwo\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"from pathlib import Path; print(Path('/data/seed.txt').read_text(), end='')\"",
          "expect": {
            "exit": 0,
            "stdout": "seed\n"
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; print(Path('/data/seed.txt').read_bytes())\"",
          "expect": {
            "exit": 0,
            "stdout": "b'seed\\n'\n"
          }
        },
        {
          "command": "python3 -c \"print(open('/data/lines.txt').read().splitlines())\"",
          "expect": {
            "exit": 0,
            "stdout": "['one', 'two']\n"
          }
        },
        {
          "command": "python3 -c \"print(open('/data/sub/inner.txt').read(), end='')\"",
          "expect": {
            "exit": 0,
            "stdout": "in\n",
            "ops_contain": [
              "read /data/sub/inner.txt"
            ]
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; Path('/data/w.txt').write_text('text')\" && cat /data/w.txt",
          "expect": {
            "exit": 0,
            "stdout": "text"
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; Path('/data/b.txt').write_bytes(b'bytes')\" && cat /data/b.txt",
          "expect": {
            "exit": 0,
            "stdout": "bytes"
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; print(Path('/data/nope.txt').read_text())\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "FileNotFoundError: [Errno 44] No such file or directory: '/data/nope.txt'"
          }
        }
      ]
    },
    {
      "id": "mutations_reach_the_mount",
      "hosts": [
        "python"
      ],
      "backends": [
        "ram",
        "s3",
        "redis"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n"
            }
          },
          "/other": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"from pathlib import Path; Path('/data/d').mkdir(); print(Path('/data/d').is_dir())\"",
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; Path('/data/d').mkdir()\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "FileExistsError"
          }
        },
        {
          "command": "echo xy > /data/d/a.txt",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; Path('/data/d/a.txt').rename('/data/d/b.txt'); print(Path('/data/d/b.txt').stat().st_size, Path('/data/d/a.txt').exists())\"",
          "expect": {
            "exit": 0,
            "stdout": "3 False\n"
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; Path('/data/d').rmdir()\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "Directory not empty"
          }
        },
        {
          "command": "cat /data/d/b.txt",
          "expect": {
            "exit": 0,
            "stdout": "xy\n"
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; Path('/data/d/b.txt').unlink(); Path('/data/d').rmdir(); print(Path('/data/d').exists())\"",
          "expect": {
            "exit": 0,
            "stdout": "False\n"
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; Path('/data/zz').rename('/data/yy')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "FileNotFoundError"
          }
        },
        {
          "command": "echo keep > /data/cross.txt && python3 -c \"from pathlib import Path; Path('/data/cross.txt').rename('/other/cross.txt')\"",
          "expect": {
            "exit": 1
          }
        },
        {
          "command": "cat /data/cross.txt",
          "expect": {
            "exit": 0,
            "stdout": "keep\n"
          }
        },
        {
          "command": "python3 -c \"import os, shutil; os.makedirs('/data/m/n'); print(os.listdir('/data/m')); shutil.rmtree('/data/m'); print(os.path.exists('/data/m'))\"",
          "expect": {
            "exit": 0,
            "stdout": "['n']\nFalse\n"
          }
        }
      ]
    },
    {
      "id": "glob_and_walk_reach_the_mount",
      "hosts": [
        "python"
      ],
      "backends": [
        "ram",
        "s3",
        "redis"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "a.txt": "a\n",
              "sub/b.txt": "b\n",
              "sub/deep/c.txt": "c\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import glob; print(sorted(glob.glob('/data/**/*.txt', recursive=True)))\"",
          "expect": {
            "exit": 0,
            "stdout": "['/data/a.txt', '/data/sub/b.txt', '/data/sub/deep/c.txt']\n"
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; print(sorted(str(p) for p in Path('/data').rglob('*.txt')))\"",
          "expect": {
            "exit": 0,
            "stdout": "['/data/a.txt', '/data/sub/b.txt', '/data/sub/deep/c.txt']\n"
          }
        },
        {
          "command": "python3 -c \"import os; print([(r, sorted(d), sorted(f)) for r, d, f in os.walk('/data')])\"",
          "expect": {
            "exit": 0,
            "stdout": "[('/data', ['sub'], ['a.txt']), ('/data/sub', ['deep'], ['b.txt']), ('/data/sub/deep', [], ['c.txt'])]\n"
          }
        },
        {
          "command": "python3 -c \"import os; print(sorted((e.name, e.is_dir()) for e in os.scandir('/data')))\"",
          "expect": {
            "exit": 0,
            "stdout": "[('a.txt', False), ('sub', True)]\n"
          }
        }
      ]
    }
  ]
