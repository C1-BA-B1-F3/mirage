{
  "suite": "wasi",
  "requires": {
    "python": [
      "env:MIRAGE_WASI_HOME"
    ],
    "typescript": []
  },
  "cases": [
    {
      "id": "sys_argv",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import sys; print('argv-len', len(sys.argv))\"",
          "expect": {
            "exit": 0,
            "stdout": "argv-len 1\n"
          }
        }
      ]
    },
    {
      "id": "script_directory_heads_sys_path",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "app/file.py": "print(__file__)\n",
              "app/imp.py": "import sys\nprint(repr(sys.path[0]))\nimport helper\n",
              "app/helper.py": "print('helper imported')\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 /ram/app/imp.py",
          "expect": {
            "exit": 0,
            "stdout": "'/ram/app'\nhelper imported\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -P /ram/app/imp.py",
          "expect": {
            "exit": 1,
            "stderr_contains": "ModuleNotFoundError: No module named 'helper'"
          }
        },
        {
          "command": "cd /ram && python3 ./app/file.py",
          "expect": {
            "exit": 0,
            "stdout": "/ram/./app/file.py\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "listing_classifies_through_stat",
      "filesystem": {
        "wasi": {
          "list": true,
          "stat": true,
          "glob": true
        }
      },
      "hosts": [
        "python"
      ],
      "backends": [
        "ram",
        "s3",
        "redis"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "MIRAGE_TEST_ROOT=/ram python3 -c",
          "script": "fs/py/list.py",
          "expect": {
            "exit": 0,
            "stdout": "seed.txt\nsub\n"
          }
        },
        {
          "command": "MIRAGE_TEST_ROOT=/ram python3 -c",
          "script": "fs/py/stat.py",
          "expect": {
            "exit": 0,
            "stdout": "file 5 32768\ndir 16384\nmissing\n"
          }
        },
        {
          "command": "MIRAGE_TEST_ROOT=/ram python3 -c",
          "script": "fs/py/glob.py",
          "expect": {
            "exit": 0,
            "stdout": "seed.txt\nsub/inner.txt\n"
          }
        }
      ]
    },
    {
      "id": "symlink_roundtrip",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import os; os.symlink('t.txt', '/ram/made')\"",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "readlink /ram/made",
          "expect": {
            "exit": 0,
            "stdout": "t.txt\n"
          }
        },
        {
          "command": "cat /ram/made",
          "expect": {
            "exit": 0,
            "stdout": "hello\n"
          }
        }
      ]
    },
    {
      "id": "readlink_and_lstat_a_shell_link",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s t.txt /ram/l",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"import os, stat\nprint(os.readlink('/ram/l'))\nst = os.lstat('/ram/l')\nprint(stat.S_ISLNK(st.st_mode), st.st_size)\nprint(os.path.islink('/ram/t.txt'))\"",
          "expect": {
            "exit": 0,
            "stdout": "t.txt\nTrue 5\nFalse\n"
          }
        }
      ]
    },
    {
      "id": "readlink_splits_its_two_misses",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "mkdir /ram/d",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"import errno, os\nfor p in ('/ram/t.txt', '/ram/d', '/ram/missing', '/ram/d/deep/missing'):\n    try:\n        os.readlink(p)\n    except OSError as exc:\n        print(p, errno.errorcode[exc.errno])\"",
          "expect": {
            "exit": 0,
            "stdout": "/ram/t.txt EINVAL\n/ram/d EINVAL\n/ram/missing ENOENT\n/ram/d/deep/missing ENOENT\n"
          }
        },
        {
          "command": "python3 -c \"import os\ntry:\n    os.readlink('/ram/missing')\nexcept FileNotFoundError:\n    print('caught as FileNotFoundError')\"",
          "expect": {
            "exit": 0,
            "stdout": "caught as FileNotFoundError\n"
          }
        }
      ]
    },
    {
      "id": "utime_reaches_the_mount",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import os; os.utime('/ram/t.txt', (100.0, 200.0))\"",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "stat -c %Y /ram/t.txt",
          "expect": {
            "exit": 0,
            "stdout": "200\n"
          }
        }
      ]
    },
    {
      "id": "hard_link_is_refused_with_eperm",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import errno, os\ntry:\n    os.link('/ram/t.txt', '/ram/hard')\nexcept OSError as exc:\n    print(exc.errno == errno.EPERM)\"",
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          }
        },
        {
          "command": "ls /ram",
          "expect": {
            "exit": 0,
            "stdout": "t.txt\n"
          }
        }
      ]
    },
    {
      "id": "scandir_reports_a_link_as_a_link",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n",
              "d/inner.txt": "x\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s t.txt /ram/lk && ln -s d /ram/dlk",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"import os\nfor e in sorted(os.scandir('/ram'), key=lambda x: x.name):\n    print(e.name, 'link' if e.is_symlink() else ('dir' if e.is_dir() else 'file'))\"",
          "expect": {
            "exit": 0,
            "stdout": "d dir\ndlk link\nlk link\nt.txt file\n"
          }
        },
        {
          "command": "python3 -c \"import os\nfor e in sorted(os.scandir('/dev'), key=lambda x: x.name):\n    print(e.name, e.is_file(), e.is_dir())\"",
          "expect": {
            "exit": 0,
            "stdout": "null False False\nzero False False\n"
          }
        }
      ]
    },
    {
      "id": "scandir_marks_links_through_a_directory_link",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "real/t.txt": "hello\n",
              "real/sub/deep.txt": "x\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s /ram/real/t.txt /ram/real/lk && ln -s /ram/real/sub /ram/real/dlk && ln -s /ram/real /ram/alias",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"import os\nfor e in sorted(os.scandir('/ram/alias'), key=lambda x: x.name):\n    print(e.name, 'link' if e.is_symlink() else ('dir' if e.is_dir() else 'file'))\"",
          "expect": {
            "exit": 0,
            "stdout": "dlk link\nlk link\nsub dir\nt.txt file\n"
          }
        }
      ]
    },
    {
      "id": "rename_a_link_moves_the_name",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s t.txt /ram/lk",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"import os\nos.rename('/ram/lk', '/ram/moved')\nprint(os.readlink('/ram/moved'))\nprint(os.path.islink('/ram/lk'))\"",
          "expect": {
            "exit": 0,
            "stdout": "t.txt\nFalse\n"
          }
        },
        {
          "command": "readlink /ram/moved",
          "expect": {
            "exit": 0,
            "stdout": "t.txt\n"
          }
        }
      ]
    },
    {
      "id": "symlink_refuses_an_occupied_name",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "mkdir /ram/d",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "ln -s t.txt /ram/lk",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"import errno, os\nfor p in ('/ram/t.txt', '/ram/d', '/ram/lk', '/ram'):\n    try:\n        os.symlink('elsewhere', p)\n        print(p, 'created')\n    except OSError as exc:\n        print(p, errno.errorcode[exc.errno])\"",
          "expect": {
            "exit": 0,
            "stdout": "/ram/t.txt EEXIST\n/ram/d EEXIST\n/ram/lk EEXIST\n/ram EEXIST\n"
          }
        },
        {
          "command": "cat /ram/t.txt",
          "expect": {
            "exit": 0,
            "stdout": "hello\n"
          }
        },
        {
          "command": "readlink /ram/lk",
          "expect": {
            "exit": 0,
            "stdout": "t.txt\n"
          }
        }
      ]
    },
    {
      "id": "a_links_own_time_reaches_the_guest",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "ln -s t.txt /ram/lk",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"import os\nos.utime('/ram/lk', (1000000000, 1000000000), follow_symlinks=False)\nst = os.lstat('/ram/lk')\nprint(int(st.st_mtime))\nprint(os.path.islink('/ram/lk'))\nprint(int(os.stat('/ram/t.txt').st_mtime) != 1000000000)\"",
          "expect": {
            "exit": 0,
            "stdout": "1000000000\nTrue\nTrue\n"
          }
        }
      ]
    },
    {
      "id": "closed_output_and_reuse",
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import sys; print('out'); sys.stderr.write('err'); sys.stdout.close(); sys.stderr.close(); assert sys.stdout.closed and sys.stderr.closed\"",
          "expect": {
            "exit": 0,
            "stdout": "out\n",
            "stderr": "err"
          }
        },
        {
          "command": "python3 -c \"import sys; print('next'); sys.stderr.write('next err')\"",
          "expect": {
            "exit": 0,
            "stdout": "next\n",
            "stderr": "next err"
          }
        },
        {
          "command": "python3 -c \"import sys; sys.stdout.buffer.write(b'binary'); sys.stdout.buffer.close()\"",
          "expect": {
            "exit": 0,
            "stdout": "binary",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"import sys; print('before exit'); sys.stdout.close(); sys.stderr.close(); sys.exit(7)\"",
          "expect": {
            "exit": 7,
            "stdout": "before exit\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"print('after exit')\"",
          "expect": {
            "exit": 0,
            "stdout": "after exit\n",
            "stderr": ""
          }
        }
      ],
      "hosts": [
        "python"
      ]
    },
    {
      "id": "no_extended_attribute_calls",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import os; print([n for n in ('getxattr', 'listxattr', 'removexattr', 'setxattr') if hasattr(os, n)])\"",
          "expect": {
            "exit": 0,
            "stdout": "[]\n"
          }
        },
        {
          "command": "python3 -c \"import os; os.listxattr('/data/t.txt')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "module 'os' has no attribute 'listxattr'"
          }
        }
      ]
    },
    {
      "id": "listing_survives_a_failing_record",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/api": {
            "vfs": "ram",
            "files": {
              "items/0.json": "{\"id\": 0}\n",
              "items/1.json": "{\"id\": 1}\n",
              "items/2.json": "{\"id\": 2}\n",
              "items/3.json": "{\"id\": 3}\n"
            },
            "failing": [
              "items/2.json"
            ]
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import errno, glob, os\nprint(sorted(os.listdir('/api/items')))\nprint(len(glob.glob('/api/items/*.json')))\nprint(os.stat('/api/items/1.json').st_size)\nfor probe in (os.stat, lambda p: open(p).read()):\n    try:\n        probe('/api/items/2.json')\n        print('served')\n    except OSError as e:\n        print(errno.errorcode[e.errno])\"",
          "expect": {
            "exit": 0,
            "stdout": "['0.json', '1.json', '2.json', '3.json']\n4\n10\nEIO\nEIO\n"
          }
        }
      ]
    },
    {
      "id": "shell_cwd",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "sub/item": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /data/sub",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; print(Path.cwd()); print(Path('item').read_text(), end=''); Path('out').write_text('written')\"",
          "expect": {
            "exit": 0,
            "stdout": "/data/sub\nhello\n"
          }
        },
        {
          "command": "cat /data/sub/out",
          "expect": {
            "exit": 0,
            "stdout": "written"
          }
        },
        {
          "command": "PWD=/wrong python3 -c \"import os; print(os.getcwd()); os.chdir('..'); raise ValueError('expected')\"",
          "expect": {
            "exit": 1,
            "stdout": "/data/sub\n",
            "stderr_contains": "expected"
          }
        },
        {
          "command": "python3 -c \"from __future__ import annotations; import os; print(os.getcwd())\"; pwd",
          "expect": {
            "exit": 0,
            "stdout": "/data/sub\n/data/sub\n"
          }
        },
        {
          "command": "printf \"import os; print(os.getcwd())\" > script.py; python3 script.py",
          "expect": {
            "exit": 0,
            "stdout": "/data/sub\n"
          }
        }
      ]
    },
    {
      "id": "open_follows_the_shared_rule",
      "hosts": [
        "python"
      ],
      "backends": [
        "ram",
        "s3",
        "redis"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"open('/data/nope.txt')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "FileNotFoundError",
            "ops_absent": [
              "create /data/nope.txt"
            ]
          }
        },
        {
          "command": "python3 -c \"open('/data/sub')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "IsADirectoryError"
          }
        },
        {
          "command": "python3 -c \"open('/data/sub', 'w')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "IsADirectoryError",
            "ops_absent": [
              "create /data/sub",
              "truncate /data/sub"
            ]
          }
        },
        {
          "command": "python3 -c \"f = open('/data/seed.txt', 'a'); f.write('more\\n'); f.close()\"",
          "expect": {
            "exit": 0,
            "ops_absent": [
              "truncate /data/seed.txt"
            ]
          }
        },
        {
          "command": "cat /data/seed.txt",
          "expect": {
            "exit": 0,
            "stdout": "seed\nmore\n"
          }
        },
        {
          "command": "python3 -c \"open('/data/new.txt', 'w').close()\"",
          "expect": {
            "exit": 0,
            "ops_contain": [
              "create /data/new.txt"
            ],
            "ops_absent": [
              "write /data/new.txt"
            ]
          }
        },
        {
          "command": "cat /data/new.txt",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "python3 -c \"open('/data/seed.txt', 'w').close()\"",
          "expect": {
            "exit": 0,
            "ops_contain": [
              "truncate /data/seed.txt"
            ]
          }
        },
        {
          "command": "cat /data/seed.txt",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "python3 -c \"open('/data/new.txt', 'x')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "FileExistsError"
          }
        },
        {
          "command": "ln -s /data/gone /data/lnk",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"open('/data/lnk', 'x')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "FileExistsError",
            "ops_absent": [
              "create /data/lnk",
              "create /data/gone"
            ]
          }
        },
        {
          "command": "python3 -c \"f = open('/data/fresh.txt', 'x'); f.write('fresh'); f.close()\" && cat /data/fresh.txt",
          "expect": {
            "exit": 0,
            "stdout": "fresh",
            "ops_contain": [
              "create /data/fresh.txt"
            ]
          }
        },
        {
          "command": "python3 -c \"open('/data/nope.txt', 'r+')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "FileNotFoundError"
          }
        },
        {
          "command": "python3 -c \"open('/data/seed.txt', 'rr')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "invalid mode: 'rr'"
          }
        },
        {
          "command": "python3 -c \"import os; f = open('/data/seed.txt', 'w'); print(os.fstat(f.fileno()).st_mtime > 0)\"",
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          }
        }
      ]
    },
    {
      "id": "content_outside_the_view_is_refused",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "wasi",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "a.txt": "a\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cat /data/a.txt",
          "expect": {
            "exit": 0,
            "stdout": "a\n"
          }
        },
        {
          "command": "cat /.bash_history",
          "expect": {
            "exit": 0,
            "stdout_contains": "cat /data/a.txt"
          }
        },
        {
          "command": "python3 -c \"print(open('/.bash_history').read())\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "FileNotFoundError",
            "ops_absent": [
              "read /.bash_history"
            ]
          }
        },
        {
          "command": "python3 -c \"open('/tmp/new.txt', 'w')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "Error",
            "ops_absent": [
              "create /tmp/new.txt"
            ]
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; print(Path('/tmp/new.txt').exists())\"",
          "expect": {
            "exit": 0,
            "stdout": "False\n"
          }
        }
      ]
    },
    {
