            "exit": 0
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; a = Path('/alias'); print(a.is_symlink(), sorted(c.name for c in Path('/').iterdir() if c.name in ('alias', 'parent')), a.read_text(), end='')\"",
          "expect": {
            "exit": 0,
            "stdout": "True ['alias', 'parent'] a\n"
