      "id": "jq_args_named_keeps_the_typed_order_across_arg_and_argjson",
      "seq": 701103,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs"
      ],
      "command": "jq -n -c --argjson a 1 --arg b x --argjson c '{\"z\":1,\"0\":2}' '$ARGS.named'",
      "expect": {
