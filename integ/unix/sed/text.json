        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "mkdir -p /data/st && printf 'bibtexurl: x\\nnext\\n' > /data/st/f && sed -i \"/^bibtexurl:/a codeurl: 'https:\\/\\/github.com\\/u\\/r'\" /data/st/f && cat /data/st/f && rm -r /data/st",
