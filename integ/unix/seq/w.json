      "command": "for f in %03d x%sy '%g%g' abc % %5 %lg %i; do seq -f \"$f\" 1; echo rc=$?; done 2>&1; seq -f %e 1; seq -f '%-5gX' 2; seq -f 'a%%b%g' 1; seq -f %Lg 1; seq -f %.g 1; seq -f %#g 1",
