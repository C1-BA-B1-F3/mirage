{
  "cases": [
    {
      "id": "github_ls_root",
      "seq": 530001,
      "targets": [
        "github"
      ],
      "command": "ls /repo",
      "expect": {
        "exit": 0,
        "stdout": "README.md\ndocs\npyproject.toml\nsrc\ntests\n",
        "stderr": ""
      }
    },
    {
      "id": "github_cat_readme",
      "seq": 530002,
      "targets": [
        "github"
      ],
      "command": "cat /repo/README.md",
      "expect": {
        "exit": 0,
        "stdout": "# repo-v1\n\nFixture repository for the fake GitHub API server.\n",
        "stderr": ""
      }
    },
    {
      "id": "github_find_name",
      "seq": 530003,
      "targets": [
        "github"
      ],
      "command": "find /repo/docs -name '*.md'",
