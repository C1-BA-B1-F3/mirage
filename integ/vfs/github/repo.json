    {
      "id": "github_rm_existing_file_is_refused_not_missing",
      "seq": 530017,
      "targets": [
        "github"
      ],
      "command": "rm /repo/README.md; head -n 1 /repo/README.md",
      "expect": {
        "exit": 0,
        "stdout": "# repo-v1\n",
        "stderr": "rm: cannot remove '/repo/README.md': Read-only file system\n"
      }
    },
    {
      "id": "github_rm_f_reports_an_existing_file_it_cannot_remove",
      "seq": 530018,
      "targets": [
        "github"
      ],
      "command": "rm -f /repo/README.md /repo/nope.md",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "rm: cannot remove '/repo/README.md': Read-only file system\n"
      }
    },
    {
      "id": "github_rm_missing_file_is_missing",
      "seq": 530019,
      "targets": [
        "github"
      ],
      "command": "rm /repo/nope.md",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "rm: cannot remove '/repo/nope.md': No such file or directory\n"
      }
    },
    {
      "id": "github_unlink_existing_file_is_refused_not_missing",
      "seq": 530020,
      "targets": [
        "github"
      ],
      "command": "unlink /repo/README.md",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "unlink: cannot unlink '/repo/README.md': Read-only file system\n"
      }
    },
    {
      "id": "github_truncated_du_preserves_refused_directory_rows",
      "seq": 530031,
      "targets": [
        "github"
      ],
      "session": "sealed",
      "command": "du /trunc/src 2>/dev/null | grep '/cache$'",
      "expect": {
        "exit": 0,
        "stdout": "0\t/trunc/src/cache\n",
        "stderr": ""
      },
      "note": "A truncated GitHub tree uses the generic folder walk: an unreadable subtree keeps its zero-byte directory row and du exits 1, as GNU coreutils 9.7 does."
    }
  ]
